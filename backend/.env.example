# F.O.R.G.E Backend Configuration Template
# Copy to .env and fill in actual values for your environment

# Flask configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-change-in-production

# Database configuration
DB_PATH=./database/forge.db

# JWT configuration
JWT_EXPIRY_HOURS=8

# LLM API configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Logging configuration
LOG_LEVEL=DEBUG

# Simulator/Stream configuration
STREAM_HZ=10
ML_WARMUP_SAMPLES=200

# Alert configuration
RISK_THRESHOLD_ALERT=85
